# 依存パッケージ（巨大・再生成可能）
node_modules/

# ビルド成果物
dist/
# SAM のビルド成果物（sam build で再生成可能）
.aws-sam/

# 環境変数（DB接続情報を含むので絶対にpushしない）
.env
.env.*
!.env.example

# Prisma が自動生成するクライアント（prisma generate で再生成可能）
generated/

# ログ・OS・エディタ
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/

# SQLite（#16の名残。誤コミット防止）
*.db
.claude/

# Docker Compose のローカル専用オーバーライド（本番 Cognito 検証など個人環境用）
compose.override.yml

# Python（ai-service）の仮想環境・キャッシュ
venv/
.venv/
__pycache__/
*.pyc
