# PostgreSQL 接続情報（compose.yml の db サービスと一致させる）
# ホスト名はDockerネットワークではサービス名「db」を使う
DATABASE_URL="postgresql://postgres:postgres@db:5432/growth_diary?schema=public"

# アプリのポート
PORT=3000

# 認証モード。ローカル開発は "dummy"（固定テストユーザーで認証をスキップ）。
# 未設定・他の値は本番扱い（実 Cognito 検証）= デフォルトを安全側にする。
AUTH_MODE=dummy

# Amazon Cognito（AUTH_MODE が dummy 以外のときに必須）
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
