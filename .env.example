# アプリのポート
PORT=3000

# 認証モード。ローカル開発は "dummy"（固定テストユーザーで認証をスキップ）。
# 未設定・他の値は本番扱い（実 Cognito 検証）= デフォルトを安全側にする。
AUTH_MODE=dummy

# Amazon Cognito（AUTH_MODE が dummy 以外のときに必須）
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB（ローカルは DynamoDB Local。Lambda では未設定で実 DynamoDB に接続）
# ホスト直実行用は localhost、compose 内のアプリは http://dynamodb-local:8000 を使う
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-northeast-1
# DynamoDB Local 用のダミー認証情報（SDK が region/credentials を要求するため）
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# テーブル名（Lambda では template.yaml が実テーブル名を渡す）
USERS_TABLE=Users
CHILDREN_TABLE=Children
GROWTH_TABLE=Growth
GROWTH_STANDARDS_TABLE=GrowthStandards
