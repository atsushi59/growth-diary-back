# アプリのポート
PORT=3000

# 認証モード。ローカル開発は "dummy"（固定テストユーザーで認証をスキップ）。
# 未設定・他の値は本番扱い（実 Cognito 検証）= デフォルトを安全側にする。
AUTH_MODE=dummy

# CORS で許可するフロントのオリジン（カンマ区切り）。未設定なら http://localhost:5173。
# 本番は Amplify ドメイン等を設定する。例: http://localhost:5173,https://main.xxxx.amplifyapp.com
FRONTEND_ORIGINS=http://localhost:5173

# Amazon Cognito（AUTH_MODE が dummy 以外のときに必須）
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB（ローカルは DynamoDB Local。Lambda では未設定で実 DynamoDB に接続）
# ホスト直実行用は localhost、compose 内のアプリは http://dynamodb-local:8000 を使う
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-northeast-1
# DynamoDB Local 用のダミー認証情報（SDK が region/credentials を要求するため）
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# テーブル名（Lambda では template.yaml が実テーブル名を渡す）
USERS_TABLE=Users
CHILDREN_TABLE=Children
GROWTH_TABLE=Growth
GROWTH_STANDARDS_TABLE=GrowthStandards

# AIボット（Python サービス）の中継先 URL。
# ホスト直実行はホスト公開ポートの http://localhost:8001（8000 は DynamoDB Local が使用）。
# compose 内は compose.yml が http://ai-service:8000 を渡すのでこの値は使われない。
AI_SERVICE_URL=http://localhost:8001
# Gemini API キー。compose の ai-service へ渡すためここに設定する（ai-service 単体起動時は ai-service/.env）。
GOOGLE_GEMINI_API_KEY=
